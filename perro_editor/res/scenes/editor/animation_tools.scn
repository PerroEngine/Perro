style = { fill = "#323842", stroke = "#4A525D", stroke_width = 1.0, radius = 0.02 }
[/UiButton]
[/tool_load]
[tool_load_text]
parent = @tool_load
[UiLabel]
size_ratio = (1.0, 1.0)
text = "Load Options"
text_size_ratio = 0.35
input_enabled = false
mouse_filter = "pass"
