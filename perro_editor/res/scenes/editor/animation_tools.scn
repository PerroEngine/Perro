[/UiTextBox]
[/tool_cli]
[tool_save]
parent = @animation_tools
[UiButton]
size_ratio = (1.0, 0.047)
click_signals = ["editor_tool_save"]
style = { fill = "#323842", stroke = "#4A525D", stroke_width = 1.0, radius = 0.02 }
[/UiButton]
[/tool_save]
[tool_save_text]
parent = @tool_save
[UiLabel]
size_ratio = (1.0, 1.0)
text = "Save Options"
text_size_ratio = 0.35
input_enabled = false
mouse_filter = "pass"
color = "#D7DBE0"
[/UiLabel]
[/tool_save_text]
[tool_load]
parent = @animation_tools
[UiButton]
size_ratio = (1.0, 0.047)
