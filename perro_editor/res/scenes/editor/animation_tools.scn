$root = @animation_tools
[animation_tools]
[UiVLayout]
anchor = "center"
size_ratio = (0.52, 0.94)
visible = false
spacing = 0.002
padding = (0.018, 0.01)
style = { fill = "#23272D", stroke = "#5A91DD", stroke_width = 1.0, radius = 0.02 }
[/UiVLayout]
[/animation_tools]
[tool_input_label]
parent = @animation_tools
[UiLabel]
size_ratio = (1.0, 0.025)
text = "Input GLB/glTF"
color = "#D7DBE0"
text_size_ratio = 0.5
h_align = "start"
[/UiLabel]
[/tool_input_label]
[tool_input]
parent = @animation_tools
[UiTextBox]
size_ratio = (1.0, 0.035)
text_size_ratio = 0.4
style = { fill = "#171A1F", stroke = "#4A525D", stroke_width = 1.0, radius = 0.02 }
[/UiTextBox]
[/tool_input]
[tool_output_label]
parent = @animation_tools
[UiLabel]
size_ratio = (1.0, 0.025)
text = "Output .panim"
color = "#D7DBE0"
text_size_ratio = 0.5
h_align = "start"
[/UiLabel]
[/tool_output_label]
[tool_output]
parent = @animation_tools
[UiTextBox]
size_ratio = (1.0, 0.035)
text_size_ratio = 0.4
style = { fill = "#171A1F", stroke = "#4A525D", stroke_width = 1.0, radius = 0.02 }
[/UiTextBox]
[/tool_output]
[tool_clip_label]
