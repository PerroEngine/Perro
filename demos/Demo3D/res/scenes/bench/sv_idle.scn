$root = @SubViewBench

# Generated by the sub-view cost measurement pass. Two identical 3D worlds:
# one in the main scene, one isolated inside a UiSubView. `enabled` on the
# sub view is the only difference between the `on`/`off` variants, so the
# node tree (and therefore main-scene isolation) is identical in both.

[SubViewBench]
    [Node3D]
        position = (0.0, 0.0, 0.0)
    [/Node3D]
[/SubViewBench]

[MainCamera]
parent = @SubViewBench
    [Camera3D]
        active = true
        perspective_fov_y_degrees = 62.0
        [Node3D]
            position = (0.0, 7.5, 17.0)
            rotation_deg = (-18.0, 0.0, 0.0)
        [/Node3D]
    [/Camera3D]
[/MainCamera]

[MainAmbient]
parent = @SubViewBench
    [AmbientLight3D]
        color = (0.62, 0.68, 0.82)
        intensity = 0.35
    [/AmbientLight3D]
[/MainAmbient]

[MainSun]
parent = @SubViewBench
    [RayLight3D]
        color = (1.0, 0.95, 0.86)
        intensity = 1.1
        cast_shadows = true
        [Node3D]
            rotation_deg = (-40.0, -32.0, 0.0)
        [/Node3D]
    [/RayLight3D]
[/MainSun]

[MainFloor]
parent = @SubViewBench
    [MeshInstance3D]
        mesh = "__cube__"
        cast_shadows = false
        receive_shadows = true
        material = {
            type = "standard",
            base_color_factor = (0.10, 0.12, 0.15, 1.0),
            roughness_factor = 0.85,
            metallic_factor = 0.0,
            alpha_mode = "OPAQUE",
